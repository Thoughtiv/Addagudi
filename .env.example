# --- Database (required for the admin, blog, uploads and saved enquiries) ---
# Include a database name at the end (here: aepl) so this site's data stays separate.
MONGODB_URI=mongodb://127.0.0.1:27017/aepl

# --- Admin sessions ---
# Random text, 32+ characters (e.g. run: openssl rand -base64 36)
AUTH_SECRET=

# Optional: force the session cookie to be HTTPS-only. It is already set automatically
# when the site is served over HTTPS behind a proxy that sends x-forwarded-proto.
# AUTH_COOKIE_SECURE=true
